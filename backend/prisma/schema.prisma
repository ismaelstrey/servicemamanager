datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cliente Prisma: gera o client TypeScript para acessar o banco
generator client {
  provider = "prisma-client-js"
}
// Gerador de diagrama ERD para visualização do modelo
generator erd {
  provider = "prisma-erd-generator"
  output   = "./diagram"
}


// Usuários internos da plataforma (admin/operadores). Gerenciam provedores,
// convites, comentários, notificações e templates de checklist.
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers Provider[]
  providerUsers ProviderUser[]
  sentInvites ProviderInvite[] @relation("InvitedBy")
  comments Comment[]
  notifications Notification[]
  changeHistories ChangeHistory[]
  createdChecklistTemplates ChecklistTemplate[]
}

// Provedor/empresa atendida pelo sistema. Centraliza dados de contato e
// relaciona equipamentos, tickets, serviços, filiais, grupos e rotinas.
model Provider {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String   @unique
  workspace String   @unique
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId Int

  equipments    Equipment[]
  tickets       Ticket[]
  passwords     PasswordVault[]
  zabbixServers ZabbixServer[]
  providerUsers ProviderUser[]
  invites       ProviderInvite[]
  serviceOrders ServiceOrder[]
  comments      Comment[]
  notifications Notification[]
  changeHistories ChangeHistory[]
  customers      Customer[]
  checklistTemplates ChecklistTemplate[]
  routines Routine[]
  branches ProviderBranch[]
  services ProviderService[]
  groups   ProviderGroup[]
}

// Filiais do provedor (unidades). Guarda contatos, endereço e observações.
model ProviderBranch {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  address    Json?
  notes      String?
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([providerId])
  @@map("provider_branches")
}

// Tipos de serviços do catálogo que o provedor expõe aos clientes.
enum ProviderServiceType {
  zabbix
  proxmox
  grafana
  erp
  other
}

// Catálogo de serviços do provedor (nome, tipo, URL, descrição e status).
// Agrupa credenciais que podem ser mostradas ao cliente conforme regras.
model ProviderService {
  id         Int                 @id @default(autoincrement())
  name       String
  type       ProviderServiceType
  url        String
  description String?
  isActive   Boolean             @default(true)
  provider   Provider            @relation(fields: [providerId], references: [id])
  providerId Int
  credentials ProviderServiceCredential[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([providerId])
  @@map("provider_services")
}

// Controle de visibilidade das credenciais:
// PUBLIC (qualquer cliente vê), PROVIDER_ONLY (apenas equipe do provedor),
// CUSTOM (apenas usuários/grupos permitidos).
enum CredentialVisibility {
  PUBLIC
  PROVIDER_ONLY
  CUSTOM
}

// Credenciais de acesso vinculadas a um serviço do provedor.
// Senha armazenada criptografada e com regras de visibilidade/acesso.
model ProviderServiceCredential {
  id          Int                  @id @default(autoincrement())
  service     ProviderService      @relation(fields: [serviceId], references: [id])
  serviceId   Int
  label       String?
  username    String
  passwordEnc String
  isActive    Boolean              @default(true)
  visibility  CredentialVisibility @default(PROVIDER_ONLY)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  allowedUsers  CredentialUserAccess[]
  allowedGroups CredentialGroupAccess[]

  @@index([serviceId])
  @@map("provider_service_credentials")
}

// Grupos de usuários do provedor. Usados para organizar permissões e
// controlar acesso a credenciais por grupo.
model ProviderGroup {
  id         Int       @id @default(autoincrement())
  name       String
  description String?
  provider   Provider  @relation(fields: [providerId], references: [id])
  providerId Int
  members    ProviderGroupMember[]
  credentialGroupAccess CredentialGroupAccess[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([providerId])
  @@map("provider_groups")
}

// Associação N:N entre grupos do provedor e usuários vinculados ao provedor.
model ProviderGroupMember {
  group     ProviderGroup @relation(fields: [groupId], references: [id])
  groupId   Int
  providerUser ProviderUser @relation(fields: [providerUserId], references: [id])
  providerUserId Int

  @@id([groupId, providerUserId])
  @@map("provider_group_members")
}

// Usuários com acesso explícito a uma credencial (modo CUSTOM).
model CredentialUserAccess {
  credential ProviderServiceCredential @relation(fields: [credentialId], references: [id])
  credentialId Int
  providerUser ProviderUser @relation(fields: [providerUserId], references: [id])
  providerUserId Int

  @@id([credentialId, providerUserId])
  @@map("credential_user_access")
}

// Grupos com acesso explícito a uma credencial (modo CUSTOM).
model CredentialGroupAccess {
  credential ProviderServiceCredential @relation(fields: [credentialId], references: [id])
  credentialId Int
  group     ProviderGroup @relation(fields: [groupId], references: [id])
  groupId   Int

  @@id([credentialId, groupId])
  @@map("credential_group_access")
}

// Vínculo entre um usuário interno e um provedor, com papel e permissões.
// Permite controlar acesso por grupo e por credenciais específicas.
model ProviderUser {
  id          Int      @id @default(autoincrement())
  role        String   // admin, manager, technician, support, viewer
  permissions String[] // Array de permissões específicas
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, providerId])
  @@map("provider_users")

  groupMemberships ProviderGroupMember[]
  credentialAccess CredentialUserAccess[]
}

// Convites para adicionar novos usuários a um provedor, com papel e
// permissões. Possui status, expiração e remetente.
model ProviderInvite {
  id          Int      @id @default(autoincrement())
  email       String
  role        String   // admin, manager, technician, support, viewer
  permissions String[] // Array de permissões específicas
  token       String   @unique
  message     String?  // Mensagem personalizada do convite
  status      String   @default("pending") // pending, accepted, expired, cancelled
  expiresAt   DateTime
  acceptedAt  DateTime?
  
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("provider_invites")
}

// Status de um equipamento no inventário do provedor.
enum EquipmentStatus {
  active
  inactive
  maintenance
}

// Tipo de equipamento (rede/servidor/virtualização etc.).
enum EquipmentType {
  switch
  olt
  router
  server
  virtualizer
  other
}

// Inventário de equipamentos do provedor, com tipo, rótulo, série e status.
model Equipment {
  id          Int      @id @default(autoincrement())
  type        EquipmentType
  label       String
  serial      String   @unique
  status      EquipmentStatus @default(active)
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Chamados de suporte/incidentes do provedor. Podem ser criados manualmente
// ou por integrações (Zabbix/API). Relaciona comentários, anexos e tags.
model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("open")
  priority    String   @default("medium")
  source      String   @default("manual") // manual, zabbix, api
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zabbixEvents ZabbixEvent[]
  serviceOrders ServiceOrder[]
  comments    Comment[]
  ticketAttachments TicketAttachment[]
  tags TicketTag[]
  checklistLinks ChecklistLink[]
}

// Status possíveis de uma ordem de serviço.
enum ServiceOrderStatus {
  pending
  in_progress
  waiting_parts
  waiting_client
  completed
  cancelled
}

// Prioridades de execução para ordens de serviço.
enum ServiceOrderPriority {
  low
  medium
  high
  urgent
}

// Comentários vinculados a tickets/ordens (internos ou visíveis ao cliente).
model Comment {
  id           Int      @id @default(autoincrement())
  content      String
  resourceType String   // 'ticket' or 'service_order'
  resourceId   Int
  isInternal   Boolean  @default(false) // internal comments vs client-visible
  isEdited     Boolean  @default(false)
  editedAt     DateTime?
  
  user         User?    @relation(fields: [userId], references: [id])
  userId       Int?
  provider     Provider @relation(fields: [providerId], references: [id])
  providerId   Int
  
  // Polymorphic relations
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  ticketId     Int?
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId Int?
  
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   Int?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("comments")
}

// Tags para organização e classificação de tickets/itens.
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  tickets   TicketTag[]

  @@map("tags")
}

// Relação N:N entre tickets e tags.
model TicketTag {
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId Int
  tag      Tag    @relation(fields: [tagId], references: [id])
  tagId    Int

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

// Anexos de arquivos relacionados a tickets.
model TicketAttachment {
  id           Int     @id @default(autoincrement())
  ticket       Ticket  @relation(fields: [ticketId], references: [id])
  ticketId     Int
  url          String
  originalName String
  mimeType     String
  size         Int?
  uploadedBy   Int?
  isPublic     Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

// Template de checklist reutilizável para processos (tickets/ordens/rotinas).
model ChecklistTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        String   @default("standard")
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ChecklistItemTemplate[]
  links       ChecklistLink[]
  routines    Routine[]

  @@map("checklist_templates")
}

// Item de um template de checklist (título, descrição, obrigatório, ordem).
model ChecklistItemTemplate {
  id                   Int               @id @default(autoincrement())
  checklistTemplate    ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  checklistTemplateId  Int
  title                String
  description          String?
  required             Boolean           @default(false)
  order                Int               @default(0)
  instances            ChecklistInstanceItem[]

  @@map("checklist_item_templates")
}

// Vincula um template de checklist a um recurso concreto (ticket/OS),
// rastreando status e progresso de execução.
model ChecklistLink {
  id                  Int               @id @default(autoincrement())
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  checklistTemplateId Int
  resourceType        String
  resourceId          Int
  status              String            @default("pending")
  progress            Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  items               ChecklistInstanceItem[]
  ticket              Ticket?           @relation(fields: [ticketId], references: [id])
  ticketId            Int?
  serviceOrder        ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId      Int?

  @@index([resourceType, resourceId])
  @@map("checklist_links")
}

// Instância executável de um item de checklist vinculada a um link.
model ChecklistInstanceItem {
  id             Int              @id @default(autoincrement())
  link           ChecklistLink    @relation(fields: [linkId], references: [id])
  linkId         Int
  itemTemplate   ChecklistItemTemplate @relation(fields: [itemTemplateId], references: [id])
  itemTemplateId Int
  done           Boolean          @default(false)
  doneAt         DateTime?
  note           String?

  @@map("checklist_items")
}

// Rotinas agendadas para automatizar processos (ex.: criar tickets/ordens).
model Routine {
  id            Int       @id @default(autoincrement())
  name          String
  enabled       Boolean   @default(true)
  provider      Provider  @relation(fields: [providerId], references: [id])
  providerId    Int
  targetType    String    @default("ALL_CUSTOMERS")
  targetIds     Json?
  daysOfWeek    Json
  time          String
  timezone      String?
  createFor     String    @default("TICKET")
  template      ChecklistTemplate? @relation(fields: [templateId], references: [id])
  templateId    Int?
  defaultCategory String?
  defaultPriority String?
  defaultSource   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          RoutineLog[]

  @@map("routines")
}

// Registro de execuções de rotinas (resultado, contagem de criados, erros).
model RoutineLog {
  id         Int      @id @default(autoincrement())
  routine    Routine  @relation(fields: [routineId], references: [id])
  routineId  Int
  runAt      DateTime
  result     String
  createdCount Int    @default(0)
  errorMessage String?
  createdAt  DateTime @default(now())

  @@map("routine_logs")
}

// Ordens de serviço (execução de trabalhos), relacionadas a tickets e
// clientes, com status, prioridade e datas.
model ServiceOrder {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  status          ServiceOrderStatus @default(pending)
  priority        ServiceOrderPriority @default(medium)
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  estimatedHours  Float?
  actualHours     Float?
  cost            Float?
  notes           String?
  
  provider        Provider @relation(fields: [providerId], references: [id])
  providerId      Int
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId        Int?
  comments        Comment[]
  checklistLinks  ChecklistLink[]
  
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerId      Int?
  customerRating  Int?
  customerFeedback String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("service_orders")
}

// Cofre simples de senhas internas do provedor (não vinculadas a serviços).
model PasswordVault {
  id          Int      @id @default(autoincrement())
  label       String
  username    String
  password    String
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  expiresAt   DateTime?
  lastRotatedAt DateTime?
  rotationIntervalDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== INTEGRAÇÃO ZABBIX =====

// Configuração de um servidor Zabbix do provedor (URL, credenciais e estado).
model ZabbixServer {
  id          Int      @id @default(autoincrement())
  name        String   // Nome identificador do servidor
  url         String   // URL da API Zabbix (ex: https://zabbix.exemplo.com)
  version     String?  // Versão do Zabbix
  apiToken    String?  // Token de API (se disponível)
  username    String?  // Usuário para autenticação
  password    String?  // Senha criptografada
  webhookToken String  @unique // Token único para webhook
  isActive    Boolean  @default(true)
  lastSync    DateTime? // Última sincronização
  
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  
  config      ZabbixConfig?
  events      ZabbixEvent[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([providerId, name])
  @@map("zabbix_servers")
}

// Configurações de integração com Zabbix (filtros, mapeamentos e automações).
model ZabbixConfig {
  id                    Int      @id @default(autoincrement())
  enabledTriggers       Boolean  @default(true)
  enabledHosts          Boolean  @default(true)
  enabledItems          Boolean  @default(false)
  severityMapping       Json     // Mapeamento de severidade Zabbix -> Sistema
  minSeverity          Int      @default(2) // Mínimo: Warning
  allowedHostGroups    String[] // Grupos de hosts permitidos
  blockedHostGroups    String[] // Grupos de hosts bloqueados
  allowedTriggerTags   String[] // Tags de trigger permitidas
  blockedTriggerTags   String[] // Tags de trigger bloqueadas
  autoCreateTickets    Boolean  @default(true)
  defaultPriority      String   @default("medium") // low, medium, high, critical
  ticketPrefix         String   @default("[ZABBIX]")
  ticketTemplate       String?  // Template personalizado para título/descrição
  
  zabbixServer         ZabbixServer @relation(fields: [zabbixServerId], references: [id], onDelete: Cascade)
  zabbixServerId       Int          @unique
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@map("zabbix_configs")
}

// Eventos recebidos do Zabbix. Usados para análise/automatização e
// eventualmente criação/atualização de tickets.
model ZabbixEvent {
  id              Int      @id @default(autoincrement())
  eventId         String   // ID único do evento no Zabbix
  eventType       String   // trigger, host, item, service
  severity        Int      // Severidade Zabbix (0-5)
  status          String   // OK, PROBLEM, UNKNOWN
  triggerName     String?  // Nome do trigger
  triggerTags     String[] // Tags do trigger
  hostName        String?  // Nome do host
  hostGroups      String[] // Grupos do host
  itemName        String?  // Nome do item (se aplicável)
  eventValue      String?  // Valor do evento
  eventTime       DateTime // Timestamp do evento no Zabbix
  acknowledgeStatus String @default("unacknowledged") // unacknowledged, acknowledged
  webhookPayload  Json     // Payload completo recebido
  processed       Boolean  @default(false)
  ticketCreated   Boolean  @default(false)
  errorMessage    String?  // Mensagem de erro se processamento falhou
  retryCount      Int      @default(0)
  
  zabbixServer    ZabbixServer @relation(fields: [zabbixServerId], references: [id])
  zabbixServerId  Int
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId        Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([zabbixServerId, eventId])
  @@index([zabbixServerId, processed])
  @@index([zabbixServerId, eventTime])
  @@map("zabbix_events")
}

// Notificações do sistema para usuários e clientes, sobre mudanças em
// entidades como tickets e ordens de serviço.
model Notification {
  id          Int      @id @default(autoincrement())
  type        String   // e.g. ticket_status_changed, service_order_status_changed
  entityType  String   // 'ticket' | 'service_order'
  entityId    Int
  title       String
  message     String
  statusFrom  String?
  statusTo    String?

  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  Int?

  isRead      Boolean  @default(false)
  readAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId, isRead])
  @@index([providerId, entityType, entityId])
  @@map("notifications")
}

// Histórico/auditoria de mudanças em entidades (quem, o quê e quando).
model ChangeHistory {
  id          Int      @id @default(autoincrement())
  entityType  String   // 'ticket' | 'service_order' | other
  entityId    Int
  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedById Int?
  field       String   // e.g. status, priority
  oldValue    String?
  newValue    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([providerId, entityType, entityId])
  @@map("change_history")
}

// Usuários clientes do provedor (acesso à área do cliente).
model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("customer_user") // customer_admin, customer_user
  phone       String?
  document    String?  // CPF/CNPJ
  address     Json?
  isActive    Boolean  @default(true)
  resetToken  String?
  resetTokenExpires DateTime?

  provider    Provider @relation(fields: [providerId], references: [id])
  providerId  Int

  serviceOrders ServiceOrder[]
  comments      Comment[]
  notifications Notification[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId, email])
  @@map("customers")
}

// ===== COMUNICAÇÃO EM TEMPO REAL E INTEGRAÇÕES (Fase 3) =====

// Tipos de canal de comunicação suportados.
enum ChannelType {
  whatsapp
  telegram
  site
}

// Estados possíveis de uma conversa.
enum ConversationStatus {
  open
  active
  closed
}

// Direção da mensagem (entrada do cliente ou saída do agente).
enum MessageDirection {
  inbound
  outbound
}

// Estado de processamento/entrega de uma mensagem.
enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

// Estado de itens na fila de envio para integrações.
enum QueueStatus {
  pending
  processing
  completed
  failed
}

// Canal de comunicação (WhatsApp, Telegram, Site) com conversas e integrações.
model Channel {
  id          Int         @id @default(autoincrement())
  type        ChannelType
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  conversations Conversation[]
  integrationAccounts IntegrationAccount[]

  @@index([type, isActive])
  @@map("channels")
}

// Conta/instância de integração com um canal (tokens, sessão e status).
model IntegrationAccount {
  id          Int       @id @default(autoincrement())
  channel     Channel   @relation(fields: [channelId], references: [id])
  channelId   Int
  baseUrl     String?
  token       String?
  sessionId   String?
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  webhookEvents WebhookEvent[]
  outboundQueue OutboundQueue[]
  conversations Conversation[]

  @@index([channelId, isActive])
  @@map("integration_accounts")
}

// Conversas em um canal entre agente e cliente, com mensagens e participantes.
model Conversation {
  id          Int                @id @default(autoincrement())
  channel     Channel            @relation(fields: [channelId], references: [id])
  channelId   Int
  integration IntegrationAccount? @relation(fields: [integrationAccountId], references: [id])
  integrationAccountId Int?
  externalId  String?
  title       String?
  status      ConversationStatus @default(open)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  participants Participant[]
  messages     Message[]
  outboundQueue OutboundQueue[]

  @@index([channelId, status])
  @@map("conversations")
}

// Participantes de uma conversa (agente/cliente) e seus metadados.
model Participant {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  role           String       // 'agent' | 'customer'
  displayName    String?
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages       Message[]

  @@index([conversationId, role])
  @@map("participants")
}

// Mensagens trocadas na conversa (texto/mídia), com status e anexos.
model Message {
  id             Int             @id @default(autoincrement())
  conversation   Conversation    @relation(fields: [conversationId], references: [id])
  conversationId Int
  participant    Participant?    @relation(fields: [participantId], references: [id])
  participantId  Int?
  direction      MessageDirection
  content        String
  mediaUrl       String?
  mimeType       String?
  status         MessageStatus   @default(queued)
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  attachments    Attachment[]

  @@index([conversationId, createdAt])
  @@index([status])
  @@map("messages")
}

// Anexos vinculados a mensagens (arquivo, tipo e tamanho).
model Attachment {
  id        Int     @id @default(autoincrement())
  message   Message @relation(fields: [messageId], references: [id])
  messageId Int
  url       String
  mimeType  String
  size      Int?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

// Eventos recebidos via webhook das integrações (armazenamento e processamento).
model WebhookEvent {
  id                 Int               @id @default(autoincrement())
  integration        IntegrationAccount @relation(fields: [integrationAccountId], references: [id])
  integrationAccountId Int
  externalEventId    String            @unique
  payload            Json
  processed          Boolean           @default(false)
  errorMessage       String?
  createdAt          DateTime          @default(now())
  processedAt        DateTime?

  @@index([integrationAccountId, processed])
  @@map("webhook_events")
}

// Fila de saída para envio de mensagens/ações às integrações, com retries.
model OutboundQueue {
  id                 Int               @id @default(autoincrement())
  integration        IntegrationAccount @relation(fields: [integrationAccountId], references: [id])
  integrationAccountId Int
  conversation       Conversation      @relation(fields: [conversationId], references: [id])
  conversationId     Int
  payload            Json
  status             QueueStatus       @default(pending)
  retries            Int               @default(0)
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([integrationAccountId, status])
  @@index([conversationId, status])
  @@map("outbound_queue")
}
