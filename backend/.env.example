# ==============================
# Arquivo de exemplo: .env (Backend)
# ==============================
# Copie este arquivo para `.env` na pasta backend e ajuste os valores.
# Comentários e valores padrão em pt-BR para facilitar configuração.

# ------------------------------
# Ambiente
# ------------------------------
NODE_ENV=development
PORT=4002

# ------------------------------
# Segurança
# ------------------------------
JWT_SECRET=changeme

# ------------------------------
# Banco de dados
# ------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telecomai

# ------------------------------
# Provedor WhatsApp
# ------------------------------
# Define o provedor principal de WhatsApp utilizado pelo backend.
# Opções suportadas: evolution | watiicket | cloud
WHATSAPP_PROVIDER=evolution

# ------------------------------
# Webhooks e Workers
# ------------------------------
# Processador de webhooks (normaliza e persiste eventos recebidos)
WEBHOOK_PROCESSOR_ENABLED=true

# Sender de mensagens outbound (polling simples)
OUTBOUND_SENDER_ENABLED=false

# Usa BullMQ para processamento outbound em fila (requer Redis)
OUTBOUND_BULLMQ_ENABLED=false

# ------------------------------
# Redis (BullMQ)
# ------------------------------
# Habilita Redis. Se ausente, habilita apenas quando REDIS_URL estiver definido.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# ------------------------------
# Armazenamento de mídia (MinIO/S3)
# ------------------------------
# Configuração de armazenamento para anexos de mensagens
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=telecomai

# Controle de download e purga de mídias
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_PURGE_ENABLED=true
MEDIA_PURGE_DAYS=7

# ------------------------------
# Observabilidade (OpenTelemetry)
# ------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=telecom-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ------------------------------
# CORS / Frontend
# ------------------------------
FRONTEND_URL=http://localhost:5173